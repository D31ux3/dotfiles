# Generated by matugen from the wallpaper (template: ~/.config/matugen/templates/kde-colors.colors).
# KDE color scheme for Dolphin and other KDE apps: kdeglobals selects it ([UiSettings] ColorScheme=Matugen),
# and they load it when they start. Values are r,g,b.
[General]
ColorScheme=Matugen
Name=Matugen

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

