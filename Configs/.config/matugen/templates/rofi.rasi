/* Generated by matugen from the wallpaper (template: ~/.config/matugen/templates/rofi.rasi) */
* {
    background:     #{{colors.surface.default.hex_stripped}}FF;
    background-alt: #{{colors.surface_container_high.default.hex_stripped}}FF;
    foreground:     #{{colors.on_surface.default.hex_stripped}}FF;
    selected:       #{{colors.primary.default.hex_stripped}}FF;
    active:         #{{colors.tertiary.default.hex_stripped}}FF;
    urgent:         #{{colors.error.default.hex_stripped}}FF;
}
