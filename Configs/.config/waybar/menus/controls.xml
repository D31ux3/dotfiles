<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu of custom/menu in waybar (left click). Each item's id is a key of "menu-actions" in
     config.jsonc, which holds its command. Styled in style.css (menu, menuitem).
     Items with a submenu hold two labels instead of a "label" property: the name, and the arrow
     on the right edge (GTK's own arrow is hidden in style.css). -->
<interface>
    <object class="GtkMenu" id="menu">

        <child>
            <object class="GtkMenuItem" id="power_menu">
                <child>
                    <object class="GtkBox">
                        <property name="spacing">24</property>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">󰓅&#x2003;Power profile</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">&#xf054;</property>
                                <style><class name="submenu-arrow"/></style>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="submenu">
                    <object class="GtkMenu">
                        <child>
                            <object class="GtkMenuItem" id="power-performance">
                                <property name="label">󰓅&#x2003;Performance</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="power-balanced">
                                <property name="label">󰾅&#x2003;Balanced</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="power-saver">
                                <property name="label">󰾆&#x2003;Power saver</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkSeparatorMenuItem"/>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="power-show">
                                <property name="label">󰋽&#x2003;Show power profile</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="brightness_menu">
                <child>
                    <object class="GtkBox">
                        <property name="spacing">24</property>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">󰃠&#x2003;Brightness</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">&#xf054;</property>
                                <style><class name="submenu-arrow"/></style>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="submenu">
                    <object class="GtkMenu">
                        <child>
                            <object class="GtkMenuItem" id="brightness-up">
                                <property name="label">󰃠&#x2003;Increase 10%</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="brightness-down">
                                <property name="label">󰃞&#x2003;Decrease 10%</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkSeparatorMenuItem"/>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="brightness-100">
                                <property name="label">󰃠&#x2003;100%</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="brightness-75">
                                <property name="label">󰃟&#x2003;75%</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="brightness-50">
                                <property name="label">󰃝&#x2003;50%</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="brightness-25">
                                <property name="label">󰃞&#x2003;25%</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="night_menu">
                <child>
                    <object class="GtkBox">
                        <property name="spacing">24</property>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">󰖔&#x2003;Night light</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="label">&#xf054;</property>
                                <style><class name="submenu-arrow"/></style>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="submenu">
                    <object class="GtkMenu">
                        <child>
                            <object class="GtkMenuItem" id="night-off">
                                <property name="label">󰖨&#x2003;Off</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkSeparatorMenuItem"/>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="night-4500">
                                <property name="label">󰖔&#x2003;Warm (4500 K)</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="night-3500">
                                <property name="label">󰖔&#x2003;Warmer (3500 K)</property>
                            </object>
                        </child>
                        <child>
                            <object class="GtkMenuItem" id="night-2500">
                                <property name="label">󰖔&#x2003;Warmest (2500 K)</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="login-screen">
                <property name="label">󰍹&#x2003;Login screen</property>
            </object>
        </child>

        <child>
            <object class="GtkMenuItem" id="wallpaper">
                <property name="label">󰸉&#x2003;Wallpaper</property>
            </object>
        </child>

        <child>
            <object class="GtkSeparatorMenuItem"/>
        </child>

        <child>
            <object class="GtkMenuItem" id="keybinds">
                <property name="label">󰌌&#x2003;Keybinds (Super + /)</property>
            </object>
        </child>

    </object>
</interface>
