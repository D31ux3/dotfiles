{
    "position": "top",
    "margin-top": 3,
    "modules-left": [
        "group/stats",
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/recording",
        "tray",
        "custom/updates",
        "group/controls",
        "custom/power"
    ],

    // Groups: several modules drawn as a single pill (see style.css)
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory"]
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "tray#network",
            "pulseaudio",
            "pulseaudio#mic",
            "battery",
            "custom/menu",
            "custom/notification"
        ]
    },

    "cpu": {
        "interval": 5,
        "format": "{}% ",
        "max-length": 10
    },
    "memory": {
        "interval": 5,
        "format": "{percentage}% ",
        "max-length": 10,
        "tooltip":true,
        "tooltip-format":"Used: {used}/{total} GiB\nAvailable: {avail} GiB\nSwap: {swapUsed}/{swapTotal} GiB ({swapPercentage}%)"
    },

    "clock": {
        "format": "{:%H:%M}  ",
        "format-alt": "{:%A, %B %d, %Y (%R)} 󰃰 ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"             : "months",
            "mode-mon-col"     : 3,
            "first-day-of-week": 1,
            "on-scroll"        : 1,
            "on-click-right"   : "mode",
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
	}
},

    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
        "all-outputs": true
    },


    // Waybar draws tray menus, so they take the colors from style.css (menu, menuitem)
    "tray": {
        "icon-size": 21,
        "spacing": 8,
        "ignore-list": ["nm-applet"]
    },
    // nm-applet (Wi-Fi/VPN menu, started in hypr/conf/autostart.lua) shown in the controls pill,
    // where the network module was. A tray can't list only one app, so this one hides the other
    // categories (nm-applet is "SystemServices") and the main tray hides nm-applet
    "tray#network": {
        "icon-size": 16,
        "ignore-list": ["ApplicationStatus", "Communications", "Hardware"]
    },


    "pulseaudio": {
        "format": "{volume}% 󰋋",
        "format-muted": "{volume}% 󰟎",
        "tooltip-format": "{desc} // Output Devices",
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    // Microphone: a second pulseaudio module that only shows the default source (input).
    // Click: pavucontrol on Input Devices. Right click: mute. Scroll: its volume (capped at 100%)
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-muted": "{format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "{volume}% 󰍭",
        "tooltip-format": "{desc} // Input Devices",
        "on-click": "pavucontrol -t 4",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 1%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-"
    },

    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "max-length": 25
    },

    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 1800,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/updates.sh menu",
        "on-click-right": "pkill -RTMIN+8 waybar"
    },

    // Left click: power profile, brightness and the keybinds cheat sheet (menus/controls.xml).
    // Each item id in the XML runs the command with the same key here
    "custom/menu": {
        "format": "󰍜",
        "tooltip-format": "Left click to open menu options",
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/menus/controls.xml",
        "menu-actions": {
            "power-performance": "~/.config/waybar/scripts/controls-menu.sh power performance",
            "power-balanced": "~/.config/waybar/scripts/controls-menu.sh power balanced",
            "power-saver": "~/.config/waybar/scripts/controls-menu.sh power power-saver",
            "power-show": "~/.config/waybar/scripts/controls-menu.sh power show",
            "brightness-up": "~/.config/waybar/scripts/controls-menu.sh brightness 10%+",
            "brightness-down": "~/.config/waybar/scripts/controls-menu.sh brightness 10%-",
            "brightness-100": "~/.config/waybar/scripts/controls-menu.sh brightness 100%",
            "brightness-75": "~/.config/waybar/scripts/controls-menu.sh brightness 75%",
            "brightness-50": "~/.config/waybar/scripts/controls-menu.sh brightness 50%",
            "brightness-25": "~/.config/waybar/scripts/controls-menu.sh brightness 25%",
            "night-off": "~/.config/waybar/scripts/controls-menu.sh night off",
            "night-4500": "~/.config/waybar/scripts/controls-menu.sh night 4500",
            "night-3500": "~/.config/waybar/scripts/controls-menu.sh night 3500",
            "night-2500": "~/.config/waybar/scripts/controls-menu.sh night 2500",
            "login-screen": "~/.config/hypr/scripts/sddm-preset.sh",
            "wallpaper": "~/.config/hypr/scripts/set-wallpaper.sh",
            "keybinds": "~/.config/hypr/scripts/cheatsheet.sh"
        }
    },

    // Red dot while recording the screen (hypr/scripts/screenrecord.sh, mainMod + Shift + R),
    // hidden otherwise. The script sends signal 10 when it starts and stops. Click: stop and save
    "custom/recording": {
        "exec": "~/.config/hypr/scripts/screenrecord.sh status",
        "return-type": "json",
        "signal": 10,
        "on-click": "~/.config/hypr/scripts/screenrecord.sh"
    },

    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/hypr/scripts/power-menu.sh",
        "tooltip": false
    }
    
}